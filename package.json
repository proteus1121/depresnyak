{
  "name": "depresnyak",
  "productName": "Кот Депресняк",
  "version": "2.0.0",
  "description": "Кот Депресняк — настольный питомец (порт с MDM Zinc/Flash на Electron + Ruffle)",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "patch-swf": "python tools/patch_swf.py assets-src/cat_original.swf app/assets/cat.swf",
    "package": "electron-packager . Depresnyak --platform=win32 --arch=x64 --icon=app/assets/cat.ico --out=dist --overwrite --asar --ignore=\"(dist|assets-src|tools)[\\/]\" --ignore=\"(README\\.md|\\.gitignore)$\""
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "@electron/packager": "20.3.0"
  }
}